# Copie para apps/api/.env e ajuste. Este arquivo fica SÓ no servidor — nunca no frontend.

NODE_ENV=development
PORT=8787
LOG_LEVEL=info

# ---- Banco ----
# Vazio = PGlite embutido (Postgres em WASM, dados em PGLITE_DIR). Em produção use um Postgres real:
# DATABASE_URL=postgres://user:pass@host:5432/derepart
# Supabase: botão "Connect" → Session pooler (porta 5432, compatível com IPv4). Ex.:
# DATABASE_URL=postgresql://postgres.SEU_PROJETO:SENHA@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
DATABASE_URL=
# auto (= require fora de localhost) | disable | require | verify (com DATABASE_CA_CERT)
DATABASE_SSL=auto
DATABASE_CA_CERT=
PGLITE_DIR=./.data/pglite

# Chave de 32 bytes (base64) para criptografar nome do destinatário, telefone, complemento e notas.
# OBRIGATÓRIA em produção e sempre que DATABASE_URL estiver definido. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Em desenvolvimento, se vazia, uma chave é criada em .data/dev-encryption.key
DATA_ENCRYPTION_KEY=

# ---- Login ----
# Com SUPABASE_URL (https://<projeto>.supabase.co), as contas ficam no Supabase Auth: a API valida os
# tokens com as chaves públicas do projeto (sem segredo). Vazio = login próprio (e-mail/senha na API).
# Configure também VITE_SUPABASE_URL e VITE_SUPABASE_PUBLISHABLE_KEY em apps/web/.env.
SUPABASE_URL=
# AUTH_PROVIDER=supabase | local   (padrão: supabase se SUPABASE_URL estiver definido)

# Origem do frontend quando servido em outro domínio (vírgula separa várias). Em dev o Vite faz proxy.
CORS_ORIGINS=
# true em produção (HTTPS). Vazio = automático (true se NODE_ENV=production)
COOKIE_SECURE=
SESSION_TTL_DAYS=30
# Servir o PWA compilado pela própria API (deploy em um único processo):
# SERVE_WEB_DIST=../web/dist

# ---- Mapas / rotas ----
# osrm | valhalla | google
MAP_PROVIDER=osrm
# Cadeia de geocoders (ordem = fallback). Padrão: cartociudad,nominatim (ou google se MAP_PROVIDER=google)
GEOCODING_PROVIDERS=cartociudad,nominatim

# OSRM: servidor demo público serve SÓ para desenvolvimento. Em produção, OSRM próprio com o extrato da Espanha.
OSRM_URL=https://router.project-osrm.org
OSRM_BIKE_URL=https://routing.openstreetmap.de/routed-bike
OSRM_MAX_TABLE_SIZE=100

VALHALLA_URL=https://valhalla1.openstreetmap.de
VALHALLA_MAX_MATRIX_LOCATIONS=50

CARTOCIUDAD_URL=https://www.cartociudad.es/geocoder/api/geocoder
NOMINATIM_URL=https://nominatim.openstreetmap.org
# A política do Nominatim exige identificação com contato:
NOMINATIM_USER_AGENT=derepart/0.1 (seu-email@exemplo.com)

# Google Maps Platform (Geocoding + Routes API). Necessária se MAP_PROVIDER=google ou GEOCODING_PROVIDERS inclui google.
GOOGLE_MAPS_API_KEY=
GOOGLE_TRAFFIC_AWARE=true

PROVIDER_TIMEOUT_MS=15000
OPTIMIZER_TIME_LIMIT_MS=1500

# ---- IA (interpretação de etiquetas quando o OCR não é suficiente) ----
# none | anthropic | openai | gemini
AI_PROVIDER=none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# Google Gemini — chave em https://aistudio.google.com/apikey (gemini-3.5-flash-lite é mais barato)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ---- Privacidade ----
# Dias até apagar os dados pessoais de rotas concluídas (cada usuário pode alterar nas configurações)
RETENTION_DEFAULT_DAYS=90
RETENTION_SWEEP_MINUTES=360
