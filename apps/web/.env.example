# Variáveis PÚBLICAS do frontend (vão para o navegador). Nunca coloque chaves secretas aqui.

# URL da API quando estiver em outro domínio. Vazio = mesma origem (/api, com proxy do Vite em dev).
VITE_API_URL=

# Estilo do mapa (MapLibre). Padrão: OpenFreeMap (grátis, sem chave).
# Alternativas: MapTiler/Stadia (a chave desses serviços é pública por natureza e restrita por domínio).
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
